#!/bin/bash

set -o errexit

[[ $( command -v xxhsum ) ]] || { echo error: xxhsum required; exit 1; }

find /a/null/data -type f -print0 | xargs -0 xxhsum | sed 's|A:/null/data||' | awk '{print "mkdir --parents /a/null/archive/data/"$2" && cp /a/null/data/"$2" /a/null/archive/data/"$2"/"$1}' | bash
find /a/null/tool -type f -print0 | xargs -0 xxhsum | sed 's|A:/null/tool||' | awk '{print "mkdir --parents /a/null/archive/tool/"$2" && cp /a/null/tool/"$2" /a/null/archive/tool/"$2"/"$1}' | bash
find /a/null/archive -type f | sed 's|/a/null/archive/||' > /a/null/index/archive.txt
code --diff /a/index/archive.txt /a/null/index/archive.txt
