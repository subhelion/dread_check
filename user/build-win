#!/bin/bash

set -o errexit

echo platform: windows

mode=${1:-"profile"}
[[ $mode == "debug" || $mode == "profile" || $mode == "release" ]] || { echo error: unrecognized mode "$mode"; exit 1; }
echo mode: $mode

rm --recursive --force /a/null/build/$mode
mkdir --parents        /a/null/build/$mode
cd                     /a/null/build/$mode

# msvc

source msvc.sh
# rc -nologo -fo main.res a:/code/main.rc
cl @a:/user/flag/$mode
[[ -f /a/static/manifest.xml ]] || link -nologo /a/null/build/$mode/main.obj -libpath:a:/null/vend/lib -manifest -manifestfile:a:/static/manifest.xml -out:a:/null/build/$mode/dread_check.exe
mt -nologo -manifest a:/static/manifest.xml -outputresource:a:/null/build/$mode/dread_check.exe;#1

# clang

[[ $mode == "debug"   ]] && { true; }
[[ $mode == "profile" ]] && { true; }
[[ $mode == "release" ]] && { true; }

# todo

[[ $mode == "release" ]] && {
	rm --force /a/null/build/release/main.obj
	rm --force /a/null/build/release/data

	cp --recursive /a/code/shader /a/null/data
	cp --recursive /a/null/data   /a/null/build/release

	rm --recursive --force   /a/null/build/release/data/debug
	rm --recursive --force   /a/null/build/release/data/resources
	rm --recursive --force   /a/null/build/release/data/wolf
	# rm --recursive --force /a/null/build/release/data/shader/wolf
}

